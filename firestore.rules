rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and private subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /tests/{testId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /dailyStats/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public Leaderboard records
    match /leaderboard/{recordId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.wpm is number
                    && request.resource.data.wpm >= 0 
                    && request.resource.data.wpm <= 350
                    && request.resource.data.accuracy is number
                    && request.resource.data.accuracy >= 0 
                    && request.resource.data.accuracy <= 100;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
